# Mobile App Environment Configuration
# Copy this file to .env for local development

# Backend API URL
# Development: http://localhost:8000/api
# Production: https://up2d8.azurewebsites.net/api
API_BASE_URL=http://localhost:8000/api
API_TIMEOUT=30000

# Azure Entra ID (MSAL) Configuration
# Get these values from Azure Portal > App Registrations
ENTRA_CLIENT_ID=your-client-id-here
ENTRA_TENANT_ID=your-tenant-id-here
ENTRA_REDIRECT_URI=msauth.com.up2d8.mobile://auth
ENTRA_API_SCOPE=api://your-api-client-id/access_as_user
